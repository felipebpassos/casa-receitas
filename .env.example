# Supabase > Project Settings > API (ou botão "Connect")
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sua-chave-publishable-ou-anon

# Login com Google no Supabase local (lido pelo `supabase start`; ver README)
# Google Cloud > APIs e serviços > Credenciais > ID do cliente OAuth (Aplicativo da Web)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=seu-client-secret
